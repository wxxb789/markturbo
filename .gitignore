# Build output
/target
/scripts/.venv/
*.py[cod]
# Anchored `/target` above only covers the workspace root. `vendor/ratex-parser`
# is a crate in its own right, so `cargo` run from inside it leaves ~178MB here.
vendor/*/target/

# Upstream source cloned for API inspection, not part of this project.
/.reference

# Editor and OS noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Local overrides that should not be shared
.env
.env.local

# Working notes from an agent session, not project documentation.
/.plans

# Scratch is disposable by default. Versioned performance evidence is an
# explicit exception.
/.scratch/*
!/.scratch/perf-and-size/
!/.scratch/perf-and-size/**
